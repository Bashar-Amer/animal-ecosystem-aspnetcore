@using Microsoft.AspNetCore.Identity
@using WebApp.Models
@inject UserManager<ApplicationUser> UserManager

@{
    string IsActive(string c, string a = "Index") =>
        ViewContext.RouteData.Values["controller"]?.ToString() == c && ViewContext.RouteData.Values["action"]?.ToString() == a ? "active" : "";
    var currentUser = User.Identity?.IsAuthenticated == true
        ? await UserManager.GetUserAsync(User)
        : null;
    var displayName = string.IsNullOrWhiteSpace(currentUser?.FullName)
        ? User.Identity?.Name
        : currentUser.FullName;
}
<header class="header">
    <nav class="navbar navbar-expand-lg py-0" aria-label="Admin navigation">
        <div class="container header-container">
            <a asp-controller="Admin" asp-action="Index" class="header-logo navbar-brand">
                <img src="~/Logo.svg" alt="AnimalEcosystem logo" class="site-logo" />
            </a>
            <button class="navbar-toggler mobile-menu-toggle border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavMenu" aria-controls="mainNavMenu" aria-expanded="false" aria-label="Toggle menu">
                <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12h18M3 6h18M3 18h18" /></svg>
            </button>
            <div class="collapse navbar-collapse" id="mainNavMenu">
                <ul class="navbar-nav header-nav mx-auto">
                    <li class="nav-item"><a asp-controller="Admin" asp-action="Index" class="nav-link @IsActive("Admin")">Dashboard</a></li>
                    <li class="nav-item"><a asp-controller="Marketplace" asp-action="Index" class="nav-link @IsActive("Marketplace")">Marketplace</a></li>
                    <li class="nav-item"><a asp-controller="Auction" asp-action="Index" class="nav-link @IsActive("Auction")">Auctions</a></li>
                    <li class="nav-item"><a asp-controller="Vet" asp-action="Index" class="nav-link @IsActive("Veterinary")">Veterinary</a></li>
                </ul>
                <div class="header-actions d-flex align-items-center gap-2">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="dropdown" data-user-menu>
                            <button class="header-user-trigger dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Open account menu">
                                <span class="header-user-avatar" aria-hidden="true">
                                    <span class="material-symbols-outlined">person</span>
                                </span>
                                <span class="header-user-name">@displayName</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end header-user-menu">
                                <li><a asp-controller="Admin" asp-action="Index" class="dropdown-item">Dashboard</a></li>
                                <li><a asp-controller="Account" asp-action="Profile" class="dropdown-item">My Profile</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        <button type="submit" class="dropdown-item text-danger">Sign Out</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-items-center gap-2" data-guest-menu>
                            <a asp-controller="Account" asp-action="Login" class="btn btn-secondary btn-sm d-none d-sm-inline-flex">Sign In</a>
                            <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-sm">Register</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </nav>
</header>
