@model WebApp.ViewModels.Home.HomeIndexViewModel
@{
    ViewData["Title"] = "AnimalEcosystem - Premium Livestock & Veterinary Exchange";
    ViewData["Description"] = "Premier regulated digital livestock auction and veterinary certified marketplace. Buy, sell, and auction animals with complete trust and biosecurity.";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/home/home.css" />
}

<section class="hero-home">
    <div class="hero-decoration hero-decoration-1"></div>
    <div class="hero-decoration hero-decoration-2"></div>
    <div class="container">
        <div class="hero-grid">
            <div class="hero-content">
                <div class="authority-badge"><span class="badge-indicator"></span><span class="badge-text">Trusted Livestock & Veterinary Ecosystem</span></div>
                <h1 class="display-hero hero-title">Everything Your Animals Need, <span class="text-secondary">In One Place.</span></h1>
                <p class="hero-description body-lg">The trusted platform for buying, selling, auctioning, and caring for livestock. Safeguarded by veterinary health checks and secure escrow transactions.</p>
                <div class="hero-actions">
                    <a asp-controller="Marketplace" asp-action="Index" class="btn btn-primary btn-lg">Browse Marketplace</a>
                    <a asp-controller="Vet" asp-action="Index" class="btn btn-outline btn-lg">Find a Veterinarian</a>
                    <a asp-controller="Auction" asp-action="Index" class="hero-link"><span class="material-symbols-outlined">gavel</span><span>Explore Live Auctions →</span></a>
                </div>
                <div class="trust-stats">
                    @foreach (var stat in Model.TrustStats)
                    {
                        <div class="stat-item"><span class="stat-value label-numeric-lg">@stat.Value</span><span class="stat-label label-sm">@stat.Label</span></div>
                    }
                </div>
            </div>
            <div class="hero-visual">
                <div class="live-auction-showcase">
                    <div class="showcase-accent"></div>
                        @if (!string.IsNullOrWhiteSpace(Model.HeroShowcase.Title))
                        {
                            <div class="showcase-header">
                                <div class="live-indicator"><span class="live-pulse"></span><span class="live-text label-sm">Live Auction</span></div>
                                <span class="lot-number label-sm">@Model.HeroShowcase.LotNumber</span>
                            </div>
                            <div class="showcase-image">
                                <img src="@Model.HeroShowcase.ImageUrl" alt="@Model.HeroShowcase.Title" data-lazy />
                                <div class="image-badge"><span class="material-symbols-outlined">verified</span><span>@Model.HeroShowcase.ImageCaption</span></div>
                            </div>
                            <div class="showcase-details">
                                <div class="showcase-title-row"><h3 class="title-md">@Model.HeroShowcase.Title</h3><span class="location-label body-sm">@Model.HeroShowcase.Location</span></div>
                                <div class="bid-info-panel">
                                    <div class="bid-amount"><span class="bid-label body-sm">Current Highest Bid</span><span class="bid-value headline-sm">@Model.HeroShowcase.CurrentBid.ToString("N0") JOD</span></div>
                                    <div class="bid-timer"><span class="timer-label label-sm">Closes in</span><span class="timer-value title-sm" data-countdown="@Model.HeroShowcase.CountdownTarget.ToString("s")">--</span></div>
                                </div>
                                <a asp-controller="Auction" asp-action="Index" class="btn btn-urgent btn-block">Place Instant Bid</a>
                            </div>
                        }
                        else
                        {
                            <div class="showcase-empty-state">
                                <div class="showcase-empty-icon"><span class="material-symbols-outlined">gavel</span></div>
                                <span class="section-eyebrow label-sm">Live Auctions</span>
                                <h2 class="headline-sm">No live auctions right now</h2>
                                <p class="body-md">New livestock auctions will appear here as soon as they go live.</p>
                                <a asp-controller="Auction" asp-action="Index" class="btn btn-primary btn-block">Browse Auctions</a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section pillars-section">
    <div class="container">
        <div class="row row-cols-1 row-cols-md-3 g-4">
            <div class="col">
                <a asp-controller="Marketplace" asp-action="Index" class="pillar-card">
                    <div class="pillar-content">
                        <div class="pillar-icon pillar-icon-primary"><span class="material-symbols-outlined">storefront</span></div>
                        <div class="pillar-text">
                            <h3 class="headline-sm pillar-title">Buy & Sell Animals</h3>
                            <p class="body-md pillar-description">Verified livestock marketplace connecting you to certified breeders and farmers worldwide with complete health documentation.</p>
                        </div>
                    </div>
                    <div class="pillar-cta"><span>Explore Animals</span><span class="material-symbols-outlined">arrow_forward</span></div>
                </a>
            </div>
            <div class="col">
                <a asp-controller="Vet" asp-action="Index" class="pillar-card">
                    <div class="pillar-content">
                        <div class="pillar-icon pillar-icon-secondary"><span class="material-symbols-outlined">medical_services</span></div>
                        <div class="pillar-text">
                            <h3 class="headline-sm pillar-title">Veterinary Care</h3>
                            <p class="body-md pillar-description">Licensed veterinary directory with tele-health consultations and on-site clinical visits from qualified professionals.</p>
                        </div>
                    </div>
                    <div class="pillar-cta"><span>Find a Doctor</span><span class="material-symbols-outlined">arrow_forward</span></div>
                </a>
            </div>
            <div class="col">
                <a asp-controller="Auction" asp-action="Index" class="pillar-card">
                    <div class="pillar-content">
                        <div class="pillar-header">
                            <div class="pillar-icon pillar-icon-tertiary"><span class="material-symbols-outlined">gavel</span></div>
                            <span class="badge badge-live"><span class="badge-pulse"></span>Live Now</span>
                        </div>
                        <div class="pillar-text">
                            <h3 class="headline-sm pillar-title">Live Auctions</h3>
                            <p class="body-md pillar-description">Transparent timed livestock auctions with verified escrow, real-time bidding notifications, and international shipping support.</p>
                        </div>
                    </div>
                    <div class="pillar-cta"><span>Enter Auctions</span><span class="material-symbols-outlined">arrow_forward</span></div>
                </a>
            </div>
        </div>
    </div>
</section>

<section class="py-5 my-5">
    <div class="container">
        <div class="p-5 text-white rounded-5 shadow-lg position-relative overflow-hidden" style="background: linear-gradient(135deg, #49230e 0%, #9d4314 100%);">
            <!-- Subtle background decorative glow -->
            <div class="position-absolute top-0 end-0 translate-middle-y bg-white opacity-10 rounded-circle" style="width: 300px; height: 300px; filter: blur(50px); pointer-events: none;"></div>

            <div class="row align-items-center gy-4 position-relative z-1">
                <div class="col-lg-6">
                    <span class="badge bg-white bg-opacity-25 text-white mb-3 px-3 py-2 rounded-pill">
                        <span class="material-symbols-outlined align-middle" style="font-size:16px;">storefront</span>
                        For Breeders &amp; Farmers
                    </span>
                    <h2 class="fw-bold mb-3 display-6" style="letter-spacing: -0.5px;">Turn Your Livestock Into Opportunity</h2>
                    <p class="text-white opacity-75 mb-0 fs-6" style="max-width: 440px; line-height: 1.6;">
                        List your animals securely on the marketplace, or launch a live auction and let verified buyers compete in real time.
                    </p>
                </div>

                <div class="col-lg-6">
                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <div class="row g-3">
                            <div class="col-sm-6">
                                <a asp-controller="MyAnimals" asp-action="Create" class="card h-100 text-decoration-none border-0 p-4 bg-white text-dark rounded-4 sell-cta-card shadow-sm">
                                    <div class="mb-3 d-inline-flex align-items-center justify-content-center rounded-3 bg-primary bg-opacity-10 text-primary" style="width:48px;height:48px;">
                                        <span class="material-symbols-outlined" style="font-size:24px;">add_box</span>
                                    </div>
                                    <h3 class="h6 fw-bold mb-1">List an Animal</h3>
                                    <p class="small text-muted mb-0">Fixed-price marketplace entry</p>
                                </a>
                            </div>
                            <div class="col-sm-6">
                                <a asp-controller="MyAnimals" asp-action="Index" class="card h-100 text-decoration-none border-0 p-4 bg-white text-dark rounded-4 sell-cta-card shadow-sm">
                                    <div class="mb-3 d-inline-flex align-items-center justify-content-center rounded-3 bg-warning bg-opacity-25 text-warning-emphasis" style="width:48px;height:48px;">
                                        <span class="material-symbols-outlined text-warning" style="font-size:24px;">gavel</span>
                                    </div>
                                    <h3 class="h6 fw-bold mb-1">Start an Auction</h3>
                                    <p class="small text-muted mb-0">Live competitive bidding</p>
                                </a>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="bg-white text-dark rounded-4 p-4 shadow-sm">
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <div class="rounded-circle bg-primary bg-opacity-10 p-3 text-primary d-flex align-items-center justify-content-center">
                                    <span class="material-symbols-outlined" style="font-size:24px;">lock_open</span>
                                </div>
                                <div>
                                    <h3 class="h6 fw-bold mb-0">Ready to sell your animals?</h3>
                                    <p class="small text-muted mb-0">Create an account to start listing or bidding.</p>
                                </div>
                            </div>
                            <div class="d-flex gap-2">
                                <a asp-controller="Account" asp-action="Register" class="btn btn-primary flex-grow-1 py-2">Get Started</a>
                                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary flex-grow-1 py-2">Sign In</a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .sell-cta-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .sell-cta-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 1rem 2rem rgba(0,0,0,0.15) !important;
        }
</style>

<section class="section featured-animals-section">
    <div class="container">
        <div class="section-header-complex">
            <div class="section-header-text">
                <span class="section-eyebrow label-sm">Premium Marketplace</span>
                <h2 class="section-title headline-lg">Featured Animals</h2>
                <p class="section-description body-md">Verified listings backed by international health certificates and direct breeder contact.</p>
            </div>
            <div class="filter-tabs">
                <button class="filter-tab active" data-category="all">All</button>
                <button class="filter-tab" data-category="sheep">Sheep</button>
                <button class="filter-tab" data-category="horse">Horses</button>
                <button class="filter-tab" data-category="goat">Goats</button>
                <button class="filter-tab" data-category="cattle">Cattle</button>
                <a asp-controller="Marketplace" asp-action="Index" class="view-all-link title-sm"><span>View Marketplace</span><span class="material-symbols-outlined">arrow_forward</span></a>
            </div>
        </div>
        <div class="grid grid-4" id="featured-animals-grid">
            @foreach (var animal in Model.FeaturedAnimals)
            {
                @await Html.PartialAsync("_FeaturedAnimalCard", animal)
            }
        </div>
    </div>
</section>

<section class="section auctions-section">
    <div class="container">
        <div class="section-header-complex">
            <div class="section-header-text">
                <div class="auction-live-badge"><span class="material-symbols-outlined">bolt</span><span class="label-sm">Live Bidding Active</span></div>
                <h2 class="section-title headline-lg">Live Livestock Auctions</h2>
                <p class="section-description body-md">Transparent timed bidding with escrow security and international shipping assistance.</p>
            </div>
            <a asp-controller="Auction" asp-action="Index" class="view-all-link title-sm"><span>Go to Auctions</span><span class="material-symbols-outlined">arrow_forward</span></a>
        </div>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var auction in Model.LiveAuctions)
            {
                <div class="col">
                    @await Html.PartialAsync("_HomeAuctionCard", auction)
                </div>
            }
        </div>
    </div>
</section>

<section class="section veterinary-section">
    <div class="container">
        <div class="section-header-complex">
            <div class="section-header-text">
                <span class="section-eyebrow label-sm">Professional Network</span>
                <h2 class="section-title headline-lg">Trusted Veterinary Network</h2>
                <p class="section-description body-md">Connect with licensed veterinary professionals for herd health, surgery, and tele-health consultations.</p>
            </div>
            <a asp-controller="Vet" asp-action="Index" class="view-all-link title-sm"><span>View All Veterinarians</span><span class="material-symbols-outlined">arrow_forward</span></a>
        </div>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var vet in Model.FeaturedVets)
            {
                <div class="col">
                    @await Html.PartialAsync("_FeaturedVetCard", vet)
                </div>
            }
        </div>
    </div>
</section>

<section class="section trust-section">
    <div class="container">
        <div class="section-header">
            <span class="section-eyebrow label-sm">Trust & Security</span>
            <h2 class="section-title headline-lg">Built for Complete Trust & Biosecurity</h2>
            <p class="section-description body-md">Designed with international agricultural standards to safeguard breeders, buyers, and animal welfare at every step.</p>
        </div>
        <div class="row row-cols-1 row-cols-md-3 g-4">
            <div class="col">
                <div class="trust-card">
                    <div class="trust-icon trust-icon-primary"><span class="material-symbols-outlined">assignment_turned_in</span></div>
                    <h3 class="headline-sm">Verified Health Documentation</h3>
                    <p class="body-md">Every animal undergoes comprehensive health certificate verification, including vaccination records, microchip registration, and complete disease screening.</p>
                </div>
            </div>
            <div class="col">
                <div class="trust-card">
                    <div class="trust-icon trust-icon-secondary"><span class="material-symbols-outlined">lock</span></div>
                    <h3 class="headline-sm">Secure Escrow Protection</h3>
                    <p class="body-md">Transactions are held securely and only released following physical handover and certified veterinary inspection at the designated transfer location.</p>
                </div>
            </div>
            <div class="col">
                <div class="trust-card">
                    <div class="trust-icon trust-icon-tertiary"><span class="material-symbols-outlined">emergency</span></div>
                    <h3 class="headline-sm">24/7 Veterinary Support</h3>
                    <p class="body-md">Direct access to licensed veterinarians through our tele-health platform, connecting livestock owners with qualified professionals worldwide.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section cta-banner-section">
    <div class="container">
        <div class="cta-banner">
            <div class="cta-decoration cta-decoration-1"></div>
            <div class="cta-decoration cta-decoration-2"></div>
            <div class="cta-content">
                <div class="cta-text">
                    <div class="cta-badge"><span class="material-symbols-outlined">shield</span><span>Trusted Trading Network</span></div>
                    <h2 class="headline-lg cta-title">Ready to join the premier livestock ecosystem?</h2>
                    <p class="body-md cta-description">Create your free account today to start buying, listing animals, bidding in live auctions, or offering certified veterinary services.</p>
                </div>
                <div class="cta-actions">
                    <a asp-controller="Account" asp-action="Register" class="btn btn-urgent btn-lg">Create Free Account</a>
                    <a asp-controller="Marketplace" asp-action="Index" class="btn btn-secondary btn-lg cta-btn-alt">Explore Marketplace</a>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/pages/home/home.js"></script>
}