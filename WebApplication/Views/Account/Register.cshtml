@model WebApp.ViewModels.Account.RegisterViewModel
@{
    ViewData["Title"] = "Create Account";
    ViewData["Description"] = "Join a trusted network of verified livestock breeders, buyers, and veterinary specialists.";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/account/register.css" />
}

<main class="register-main">
    <div class="register-decorations">
        <div class="decoration decoration-1"></div>
        <div class="decoration decoration-2"></div>
    </div>

    <div class="container flex-center">
        <div class="card register-card">
            <div class="card-body">
                <div class="register-header text-center mb-xl">
                    @* <div class="badge badge-verified mb-sm"><span class="w-2 h-2 rounded-full bg-secondary pulse-dot-sm"></span>Verified Registry</div> *@
                    <div class="register-icon mb-sm"><span class="material-symbols-outlined" style="font-variation-settings:'FILL' 1;">badge</span></div>
                    <h1 class="headline-md">Create an Account</h1>
                    <p class="body-md text-muted mt-xs">Join a trusted network of verified livestock breeders, buyers, and veterinary specialists.</p>
                </div>

                <form asp-controller="Account" asp-action="Register" method="post" id="registerForm">
                    <div asp-validation-summary="ModelOnly" class="alert alert-error" role="alert"></div>

                    <div class="form-group">
                        <label class="form-label">Account Classification</label>
                        <div class="role-selector" role="radiogroup" aria-label="Account Classification">
                            <button type="button" class="role-btn @(Model.Role == "breeder" ? "active" : "")" id="roleBreeder" data-role="breeder"><span class="material-symbols-outlined" style="font-size:18px;">agriculture</span><span>Livestock Breeder / Buyer</span></button>
                            <button type="button" class="role-btn @(Model.Role == "vet" ? "active" : "")" id="roleVet" data-role="vet"><span class="material-symbols-outlined" style="font-size:18px;">medical_services</span><span>Certified Veterinarian</span></button>
                        </div>
                        <input type="hidden" id="accountRole" asp-for="Role" />
                    </div>

                    <div class="form-group">
                        <label asp-for="FullName" class="form-label"></label>
                        <div style="position:relative;">
                            <span class="input-icon-left"><span class="material-symbols-outlined text-muted" style="font-size:20px;">person</span></span>
                            <input asp-for="FullName" class="form-input" style="padding-left:44px;" placeholder="e.g., Tariq Al-Husseini" />
                        </div>
                        <span asp-validation-for="FullName" class="text-error body-sm"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Email" class="form-label"></label>
                        <div style="position:relative;">
                            <span class="input-icon-left"><span class="material-symbols-outlined text-muted" style="font-size:20px;">mail</span></span>
                            <input asp-for="Email" class="form-input" style="padding-left:44px;" placeholder="name@example.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-error body-sm"></span>
                    </div>

                    <div class="register-field-grid">
                        <div class="form-group">
                            <label asp-for="PhoneNumber" class="form-label">
                                @* <span class="material-symbols-outlined form-label-icon">phone</span> *@
                                Phone Number <span class="optional-label">Optional</span>
                            </label>
                            <div class="input-with-icon">
                                <span class="input-icon-left"><span class="material-symbols-outlined text-muted">phone</span></span>
                                <input asp-for="PhoneNumber" class="form-input" placeholder="+962 7X XXX XXXX" autocomplete="tel" />
                            </div>
                            <span asp-validation-for="PhoneNumber" class="text-error body-sm"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Country" class="form-label">
                                @* <span class="material-symbols-outlined form-label-icon">public</span> *@
                                Country
                            </label>
                            <div class="input-with-icon">
                                <span class="input-icon-left"><span class="material-symbols-outlined text-muted">public</span></span>
                                <input asp-for="Country" class="form-input" style="padding-left:44px;" placeholder="Jordan" autocomplete="country-name" />
                            </div>
                            <span asp-validation-for="Country" class="text-error body-sm"></span>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="City" class="form-label">
                            @* <span class="material-symbols-outlined form-label-icon">location_city</span> *@
                            City
                        </label>
                        <div class="input-with-icon">
                            <span class="input-icon-left"><span class="material-symbols-outlined text-muted">location_city</span></span>
                            <select asp-for="City" class="form-input register-select" autocomplete="address-level2">
                                <option value="">Select your city</option>
                                <option value="Amman">Amman</option>
                                <option value="Zarqa">Zarqa</option>
                                <option value="Irbid">Irbid</option>
                                <option value="Aqaba">Aqaba</option>
                                <option value="Salt">Salt</option>
                                <option value="Madaba">Madaba</option>
                                <option value="Mafraq">Mafraq</option>
                                <option value="Jerash">Jerash</option>
                                <option value="Karak">Karak</option>
                                <option value="Tafilah">Tafilah</option>
                                <option value="Ma'an">Ma'an</option>
                            </select>
                        </div>
                        <span asp-validation-for="City" class="text-error body-sm"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Password" class="form-label"></label>
                        <div class="password-input-wrapper">
                            <span class="input-icon-left"><span class="material-symbols-outlined text-muted" style="font-size:20px;">lock</span></span>
                            <input asp-for="Password" class="form-input" style="padding-left:44px;padding-right:44px;" placeholder="Create a strong password (min 8 chars)" />
                            <button type="button" class="btn-toggle-password" id="togglePasswordBtn" aria-label="Toggle password visibility"><span class="material-symbols-outlined" id="passwordToggleIcon">visibility</span></button>
                        </div>
                        <span asp-validation-for="Password" class="text-error body-sm"></span>
                        <div class="password-strength-container mt-xs">
                            <div class="flex-between"><span class="label-sm text-muted" id="strengthText">Security Strength: None</span><span class="label-sm text-muted">Min. 8 characters</span></div>
                            <div class="strength-bars">
                                <div class="strength-bar" id="bar1"></div>
                                <div class="strength-bar" id="bar2"></div>
                                <div class="strength-bar" id="bar3"></div>
                                <div class="strength-bar" id="bar4"></div>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <div class="password-input-wrapper">
                            <span class="input-icon-left"><span class="material-symbols-outlined text-muted" style="font-size:20px;">lock_reset</span></span>
                            <input asp-for="ConfirmPassword" class="form-input" style="padding-left:44px;padding-right:44px;" placeholder="Re-enter your password" />
                            <button type="button" class="btn-toggle-password" id="confirmToggleBtn" aria-label="Toggle confirm password visibility"><span class="material-symbols-outlined" id="confirmToggleIcon">visibility</span></button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-error body-sm"></span>
                    </div>

                    <div class="form-group">
                        <label class="terms-label flex items-start gap-xs cursor-pointer">
                            <input type="checkbox" asp-for="AgreeToTerms" style="margin-top:4px;" />
                            <span class="body-sm text-muted">I agree to the 
                                <a href="#" class="text-primary" style="font-weight:700;text-decoration:none;">Terms of Service</a>, 
                                @* <a href="#" class="text-primary" style="font-weight:700;text-decoration:none;">Auction Guidelines</a>,  *@
                                @* and <a href="#" class="text-primary" style="font-weight:700;text-decoration:none;">Escrow Protection Policy</a> under Standard Commercial Regulation. *@
                            </span>
                        </label>
                        <span asp-validation-for="AgreeToTerms" class="text-error body-sm"></span>
                    </div>

                    <button type="submit" class="btn btn-primary btn-block flex-center">
                        <span>Create Account</span>
                        <span class="material-symbols-outlined" style="font-size:18px;">arrow_forward</span>
                    </button>
                </form>

                <div class="register-footer text-center p-md mt-lg">
                    <p class="body-md text-muted">Already have an account? <a asp-controller="Account" asp-action="Login" class="text-primary" style="font-weight:700;text-decoration:none;">Sign In</a></p>
                </div>
            </div>
        </div>
    </div>

    <div class="trust-indicators text-center mt-xl">
        <div class="flex-center gap-sm flex-wrap text-muted mb-xs">
            <div class="flex-center gap-xs"><span class="material-symbols-outlined text-secondary">verified_user</span><span class="label-sm">Safe & Verified Livestock Trading</span></div>
            <span class="d-none d-sm-inline">•</span>
            <div class="flex-center gap-xs"><span class="material-symbols-outlined text-secondary">shield</span><span class="label-sm">Verified Seller Verification</span></div>
        </div>
    </div>
</main>

@section Scripts {
    <script src="~/js/pages/account/register.js"></script>
}