@model WebApp.ViewModels.Account.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    ViewData["Description"] = "Sign in to AnimalEcosystem to access verified livestock auctions, marketplace listings, and veterinary records.";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/login.css" />
}

<main class="login-main">
    <div class="login-decorations">
        <div class="decoration decoration-1"></div>
        <div class="decoration decoration-2"></div>
        <div class="decoration decoration-3"></div>
    </div>

    <div class="container flex-center">
        <div class="card login-card">
            <div class="card-body">
                <div class="login-header text-center mb-xl">
                    <div class="login-icon"><span class="material-symbols-outlined">pets</span><span class="pulse-dot"></span></div>
                    @* <div class="badge badge-verified mb-sm"><span class="material-symbols-outlined" style="font-size: 16px;">verified_user</span>Secure Portal</div> *@
                    <h1 class="headline-md">Welcome back</h1>
                    <p class="body-md text-muted mt-xs">Sign in to access verified livestock auctions, marketplace listings, and veterinary records.</p>
                </div>

                <form asp-controller="Account" asp-action="Login" method="post">
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-error" role="alert"></div>

                    <div class="form-group">
                        <label asp-for="Email" class="form-label flex-between">
                            <span><span class="material-symbols-outlined text-muted" style="font-size: 18px; vertical-align: middle;">mail</span> Email Address</span>
                            @* <span class="label-sm text-muted">Required</span> *@
                        </label>
                        <input asp-for="Email" class="form-input" placeholder="name@example.com" />
                        <span asp-validation-for="Email" class="text-error body-sm"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Password" class="form-label flex-between">
                            <span><span class="material-symbols-outlined text-muted" style="font-size: 18px; vertical-align: middle;">lock</span> Password</span>
                            @* <a asp-controller="Account" asp-action="ForgotPassword" class="label-sm text-secondary" style="text-decoration: none;">Forgot password?</a> *@
                        </label>
                        <div class="password-input-wrapper">
                            <input asp-for="Password" class="form-input" placeholder="password" />
                            <button type="button" class="btn-toggle-password" id="togglePasswordBtn" aria-label="Toggle password visibility">
                                <span class="material-symbols-outlined" id="passwordToggleIcon">visibility</span>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-error body-sm"></span>
                    </div>

                    @* <div class="form-group flex-between mt-sm">
                        <label class="remember-me">
                            <input type="checkbox" asp-for="RememberMe" />
                            <span class="body-sm text-muted">Remember this device for 30 days</span>
                        </label>
                    </div> *@

                    <button type="submit" class="btn btn-primary btn-block mt-md flex-center">
                        Sign In to AnimalEcosystem
                        <span class="material-symbols-outlined">arrow_forward</span>
                    </button>
                </form>

                @* <div class="login-divider my-lg"><span>Or continue with</span></div> *@

                @* <div class="row row-cols-2 g-2 mb-xl">
                    <div class="col"><button class="btn btn-outline flex-center w-100" type="button"><span class="material-symbols-outlined text-primary">shield</span> Secure ID</button></div>
                    <div class="col"><button class="btn btn-outline flex-center w-100" type="button"><span class="material-symbols-outlined text-muted">sms</span> Phone OTP</button></div>
                </div> *@

                <div class="login-footer text-center p-md">
                    <p class="body-sm text-muted">
                        Don't have an account?
                        <a asp-controller="Account" asp-action="Register" class="text-primary" style="font-weight: 700; text-decoration: none;">Register for free <span class="material-symbols-outlined" style="font-size: 14px; vertical-align: middle;">chevron_right</span></a>
                    </p>
                </div>
            </div>
        </div>
    </div>

    @* <div class="trust-indicators text-center mt-xl">
        <div class="flex-center gap-sm flex-wrap text-muted mb-xs">
            <div class="flex-center gap-xs"><span class="material-symbols-outlined text-secondary">verified</span><span class="label-sm">Livestock Standard Compliance</span></div>
            <span class="d-none d-sm-inline">•</span>
            <div class="flex-center gap-xs"><span class="material-symbols-outlined text-secondary">lock</span><span class="label-sm">256-Bit Escrow Protection</span></div>
        </div>
        <p class="body-sm text-muted">Authorized by Veterinary Guidelines & Digital Commerce Regulations.</p>
    </div> *@
</main>

@section Scripts {
    <script src="~/js/login.js"></script>
}